{
  "name": "vite-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{scss,css,json,md,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
